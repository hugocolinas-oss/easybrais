# =============================================================================
# Easy Brais — Variables de entorno
# =============================================================================
# Copia este archivo como .env.local y rellena los valores.
# Las variables con NEXT_PUBLIC_ son visibles en el navegador.
# =============================================================================

# Supabase — Proyecto
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key

# Supabase — Service Role (solo servidor, NUNCA exponer en cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# URLs de las apps
NEXT_PUBLIC_RESERVAS_URL=http://localhost:3000
NEXT_PUBLIC_GESTION_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=https://reservas.easybrais.es
RESERVAS_URL=https://reservas.easybrais.es

# SMTP — Email transaccional (opcional, el sistema funciona sin esto)
# Brevo SMTP Relay
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=aa2712001@smtp-brevo.com
SMTP_PASS=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM_NAME=Easy Brais
SMTP_FROM_EMAIL=info@easybrais.es
SMTP_REPLY_TO=info@easybrais.es

# Email interno de gestión
ADMIN_EMAIL=gestion.easybrais@gmail.com
