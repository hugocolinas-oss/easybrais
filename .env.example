# =============================================================================
# Easy Brais — Variables de entorno
# =============================================================================
# Copia este archivo como .env.local y rellena los valores.
# Las variables con NEXT_PUBLIC_ son visibles en el navegador.
# =============================================================================

# Supabase — Proyecto
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key

# Supabase — Service Role (solo servidor, NUNCA exponer en cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# URLs de las apps
NEXT_PUBLIC_RESERVAS_URL=http://localhost:3000
NEXT_PUBLIC_GESTION_URL=http://localhost:3001

# SMTP — Email transaccional (opcional, el sistema funciona sin esto)
# Compatible con cualquier proveedor: Gmail, SendGrid, Mailgun, SES, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-usuario@example.com
SMTP_PASS=tu-password
SMTP_FROM_NAME=Easy Brais
SMTP_FROM_EMAIL=reservas@easybrais.es
