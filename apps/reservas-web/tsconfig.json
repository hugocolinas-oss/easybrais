{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@easybrais/types": ["./src/packages/types/src/index.ts"],
      "@easybrais/types/*": ["./src/packages/types/src/*"],
      "@easybrais/ui": ["./src/packages/ui/src/index.ts"],
      "@easybrais/ui/*": ["./src/packages/ui/src/*"],
      "@easybrais/utils": ["./src/packages/utils/src/index.ts"],
      "@easybrais/utils/*": ["./src/packages/utils/src/*"]
    },
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
